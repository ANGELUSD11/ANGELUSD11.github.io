---
import ParticleDrift from "@/components/ui/particle-drift";

export interface Props {
    title?: string;
}

const { title = "ANGELUS11 - Developer" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta
            name="description"
            content="ANGELUSD11 - Desarrollador Python🐍, bots, gamedev - Godot. Proyectos y Social Media."
        />
        <meta name="author" content="ANGELUS11" />
        <meta
            name="keywords"
            content="ANGELUS11, ANGELUSD11, developer, Python"
        />
        <meta
            property="og:image"
            content="https://angelus11.dev/images/patrondiamantes.jpg"
        />
        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content="ANGELUSD11 - Desarrollador Python🐍, bots, gamedev - Godot. Proyectos y Social Media."
        />
        <link rel="icon" type="image/png" href="/icons/icon_glow.png" />

        <!-- Bootstrap CSS -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
            rel="stylesheet"
        />
        <!-- Font Awesome -->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <!-- Custom CSS -->
        <link rel="stylesheet" href="/styles.css" />
        <!-- Extra CSS slot -->
        <slot name="head" />
    </head>
    <body class="text-light" style="background-color: #030509; min-height: 100vh;">
        <!-- Fondo animado fijo en todas las páginas -->
        <div style="position: fixed; inset: 0; z-index: 0; pointer-events: none;">
            <ParticleDrift client:load mode="dark" />
        </div>
        
        <!-- Contenedor principal para elevar el contenido por encima del fondo -->
        <div style="position: relative; z-index: 10;">
            <slot />
        </div>

        <!-- Bootstrap JS -->
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
        ></script>
        <slot name="scripts" />

        <!-- Custom JS for language switching, etc can go in children or just the common ones -->
        <script is:inline src="/portfolio-script.js"></script>
    </body>
</html>
