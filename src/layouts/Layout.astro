---
import "../styles/terminal.css";

export interface Props {
    title?: string;
    /** Ruta que se muestra en la barra de título, ej. "~/devlog" */
    path?: string;
    /** Ventana activa en la barra de tmux */
    active?: "home" | "devlog" | "advad";
    canonical?: string;
}

const {
    title = "ANGELUS11 - Developer",
    path = "~",
    active = "home",
    canonical,
} = Astro.props;

const canonicalURL = canonical
    ? new URL(canonical, Astro.site ?? Astro.url)
    : new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const windows = [
    { id: "home", href: "/", label: "0:home" },
    { id: "devlog", href: "/blog", label: "1:devlog" },
    { id: "advad", href: "/advad", label: "2:advad" },
];

// Temas de color: los valores viven en terminal.css (:root[data-theme=...])
const themes = [
    { id: "cyan", color: "#3fe0ff", label: "Cian / Cyan" },
    { id: "green", color: "#5cff8f", label: "Verde / Green" },
    { id: "yellow", color: "#ffd23f", label: "Amarillo / Yellow" },
    { id: "pink", color: "#ff6ec7", label: "Rosa / Pink" },
    { id: "navy", color: "#5b8cff", label: "Azul oscuro / Navy" },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="canonical" href={canonicalURL.href} />
        <meta
            name="description"
            content="ANGELUSD11 - Desarrollador Python🐍, bots, gamedev - Godot. Proyectos y Social Media."
        />
        <meta name="author" content="ANGELUS11" />
        <meta
            name="keywords"
            content="ANGELUS11, ANGELUSD11, developer, Python"
        />
        <meta name="theme-color" content="#04070b" />
        <!-- Aplica el tema guardado antes de pintar, para que no parpadee el cian -->
        <script is:inline>
            try {
                var t = localStorage.getItem("theme");
                if (/^(green|yellow|pink|navy)$/.test(t))
                    document.documentElement.dataset.theme = t;
            } catch (e) {}
        </script>
        <meta
            property="og:image"
            content="https://angelus11.dev/images/patrondiamantes.jpg"
        />
        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content="ANGELUSD11 - Desarrollador Python🐍, bots, gamedev - Godot. Proyectos y Social Media."
        />
        <link rel="icon" type="image/png" href="/icons/icon_glow.png" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+Symbols+2&display=swap"
            rel="stylesheet"
        />
        <!-- Extra CSS slot -->
        <slot name="head" />
    </head>
    <body>
        <!-- Fondo: olas ASCII animadas (ver initWaves en portfolio-script.js) -->
        <canvas id="waves" class="waves" aria-hidden="true"></canvas>

        <header class="titlebar">
            <span class="tb-mark" aria-hidden="true">◆</span>
            <span class="tb-title">angelus11@dev: <b>{path}</b> — bash</span>
            <div
                class="theme-pick"
                role="group"
                aria-label="Color del tema / Theme color"
            >
                {
                    themes.map((t) => (
                        <button
                            type="button"
                            class="theme-dot"
                            data-theme-set={t.id}
                            aria-pressed={t.id === "cyan" ? "true" : "false"}
                            aria-label={t.label}
                            title={t.label}
                            style={`--dot:${t.color}`}
                        />
                    ))
                }
            </div>
            <button
                id="langBtn"
                class="lang-btn"
                type="button"
                aria-label="Cambiar idioma / Switch language"
            >
                <span data-lang="es" class="on">es</span>|<span data-lang="en"
                    >en</span
                >
            </button>
        </header>

        <main class="screen">
            <slot />
        </main>

        <nav class="tmux" aria-label="Principal">
            <span class="tmux-session" aria-hidden="true">[a11]</span>
            {
                windows.map((w) => (
                    <a
                        href={w.href}
                        aria-current={w.id === active ? "page" : undefined}
                    >
                        {w.label}
                    </a>
                ))
            }
            <span class="tmux-right" aria-hidden="true"
                >"dev" <span id="clock"></span></span
            >
        </nav>

        <slot name="scripts" />
        <script is:inline src="/portfolio-script.js"></script>
    </body>
</html>
