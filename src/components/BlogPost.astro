---
export interface Props {
    titleEs: string;
    titleEn: string;
    dateEs: string;
    dateEn: string;
    color?: string;
}

const { titleEs, titleEn, dateEs, dateEn, color = 'primary' } = Astro.props;
---

<article class="blog-post panel" data-color={color} data-title="post.md">
    <h2 class="post-title" data-es={titleEs} data-en={titleEn}>{titleEs}</h2>
    <p class="post-date" data-es={dateEs} data-en={dateEn}>{dateEs}</p>
    <div class="post-body">
        <slot />
    </div>
</article>
