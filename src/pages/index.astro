---

<Layout title="ANGELUS11 - Developer" path="~" active="home">
  <!-- Boot: banner ASCII -->
  <section class="block" id="top">
    <Prompt cmd="./angelus11 --init" />
    <div class="out">
      <h1 class="sr-only">ANGELUS11</h1>
      <pre class="ascii banner" aria-hidden="true">{banner}</pre>
      <p
        class="tagline"
        data-es="Desarrollador de software/gamedev"
        data-en="Software Developer/gamedev"
      >
        Desarrollador de software/gamedev
      </p>
    </div>
  </section>

  <!-- neofetch -->
  <section class="block" id="fetch">
    <Prompt cmd="neofetch" />
    <div class="out fetch">
      <pre class="ascii fetch-art" aria-hidden="true">{logo}</pre>
      <div class="fetch-info">
        <div class="fetch-head">angel<span>@</span>angelus11.dev</div>
        <div class="fetch-rule" aria-hidden="true">--------------------</div>
        <dl>
          <div class="fetch-row">
            <dt data-es="Rol" data-en="Role">Rol</dt>
            <dd
              data-es="Desarrollador e investigador de software"
              data-en="Software developer & researcher"
            >
              Desarrollador e investigador de software
            </dd>
          </div>
          <div class="fetch-row">
            <dt>Uptime</dt>
            <dd data-es="21 años" data-en="21 years">21 años</dd>
          </div>
          <div class="fetch-row">
            <dt data-es="Estudios" data-en="Studies">Estudios</dt>
            <dd data-es="Ingeniería de software" data-en="Software engineering">
              Ingeniería de software
            </dd>
          </div>
          <div class="fetch-row">
            <dt>Shell</dt>
            <dd>python 🐍</dd>
          </div>
          <div class="fetch-row">
            <dt>Engine</dt>
            <dd>Godot</dd>
          </div>
          <div class="fetch-row">
            <dt data-es="Suscriptores en YouTube" data-en="YouTube Subscribers">
              Suscriptores en YouTube
            </dt>
            <dd id="subscriberCount">...</dd>
          </div>
        </dl>
        <div class="swatches" aria-hidden="true">
          {swatches.map((c) => <i style={`background:${c}`} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="block" id="about">
    <Prompt cmd="cat about.txt" />
    <div class="out">
      <p
        class="prose"
        id="about-text"
        data-es="Mi nombre es Angel💠, tengo 21 años. Desde los 16 me inicié en la programación de manera autodidacta, impulsado por una fuerte pasión por la tecnología y la innovación. Actualmente me desempeño como desarrollador e investigador de software en proyectos empresariales, mientras curso la carrera de ingeniería de software. Tengo mayor dominio en el ecosistema de Python🐍 y diversas librerías para visión por computadora, backend y videojuegos. También desarrollo juegos con Godot y comparto mi proceso en YouTube, donde hablo de programación, modding y gamedev."
        data-en="My name is Angel💠, I'm 21 years old. Since I was 16, I've been self-taught in programming, driven by a passion for technology and innovation. I currently work as a software developer and researcher on enterprise projects, while studying software engineering. My core expertise is in the Python🐍 ecosystem, including libraries for computer vision, backend, and game development. I also build games with Godot and share my journey on YouTube, covering programming, modding, and gamedev."
      >
        Mi nombre es Angel💠, tengo 21 años. Desde los 16 me inicié en la
        programación de manera autodidacta, impulsado por una fuerte pasión por
        la tecnología y la innovación. Actualmente me desempeño como
        desarrollador e investigador de software en proyectos empresariales,
        mientras curso la carrera de ingeniería de software. Tengo mayor dominio
        en el ecosistema de Python🐍 y diversas librerías para visión por
        computadora, backend y videojuegos. También desarrollo juegos con Godot
        y comparto mi proceso en YouTube, donde hablo de programación, modding y
        gamedev.
      </p>
    </div>
  </section>

  <!-- Social links -->
  <section class="block" id="links">
    <Prompt cmd="ls -la ~/links" />
    <div class="out">
      <ul class="ls">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.dir ? undefined : "_blank"}
                rel={l.dir ? undefined : "noopener noreferrer"}
              >
                <span class="perm">{l.dir ? "drwxr-xr-x" : "lrwxrwxrwx"}</span>
                <span class="name">{l.name}</span>
                <span class="arrow">-&gt;</span>
                <span class="target">{l.target}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience -->
  <section class="block" id="experience">
    <Prompt cmd="git log --stat experience" />
    <div class="out commit">
      <p class="commit-meta">
        <span class="commit-hash">commit gse-2026</span>{" "}
        <span class="commit-ref">(GSE Colombia)</span>
      </p>
      <p class="commit-meta">
        Org:&nbsp;&nbsp;
        <span
          data-es="GSE Colombia · Semillero de Investigación Interno"
          data-en="GSE Colombia · Internal Research Incubator"
          >GSE Colombia · Semillero de Investigación Interno</span
        >
      </p>
      <p class="commit-meta">
        Date:&nbsp;
        <span
          data-es="Marzo 2026 — Agosto 2026"
          data-en="March 2026 — August 2026">Marzo 2026 — Agosto 2026</span
        >
      </p>

      <h3
        data-es="Investigador & Desarrollador de Software"
        data-en="Software Researcher & Developer"
      >
        Investigador & Desarrollador de Software
      </h3>
      <p
        class="prose"
        data-es="Formé parte del semillero de investigación interno de GSE Colombia, donde fui parte del diseño, desarrollo e investigación de software empresarial. Mi trabajo abarcó desde el desarrollo de herramientas de gestión de proyectos y soluciones gerenciales, hasta la exploración e implementación de tecnologías emergentes orientadas a la automatización y la eficiencia operativa."
        data-en="I was part of the internal research incubator at GSE Colombia, where I was involved in the design, development, and research of enterprise software. My work spanned from building project management tools and managerial solutions to exploring and implementing emerging technologies focused on automation and operational efficiency."
      >
        Formé parte del semillero de investigación interno de GSE Colombia,
        donde fui parte del diseño, desarrollo e investigación de software
        empresarial. Mi trabajo abarcó desde el desarrollo de herramientas de
        gestión de proyectos y soluciones gerenciales, hasta la exploración e
        implementación de tecnologías emergentes orientadas a la automatización
        y la eficiencia operativa.
      </p>

      <ul class="tree">
        <li>
          <div>
            <h4
              data-es="Orquestador de Agentes IA"
              data-en="AI Agent Orchestrator"
            >
              Orquestador de Agentes IA
            </h4>
            <p
              data-es="Plataforma interna para orquestar agentes de inteligencia artificial, orientada al desarrollo de software asistido por modelos de lenguaje."
              data-en="Internal platform for orchestrating AI agents, aimed at model-assisted software development."
            >
              Plataforma interna para orquestar agentes de inteligencia
              artificial, orientada al desarrollo de software asistido por
              modelos de lenguaje.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h4
              data-es="Monitor DevOps & Gestión de Servidores"
              data-en="DevOps Monitor & Server Management"
            >
              Monitor DevOps & Gestión de Servidores
            </h4>
            <p
              data-es="Herramienta de monitoreo de procesos DevOps y administración de servidores para mejorar la visibilidad y control del ciclo de vida del software."
              data-en="DevOps process monitoring and server management tool to improve visibility and control over the software lifecycle."
            >
              Herramienta de monitoreo de procesos DevOps y administración de
              servidores para mejorar la visibilidad y control del ciclo de vida
              del software.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="block" id="projects">
    <Prompt cmd="ls ~/projects" />
    <div class="out projects">
      <article class="panel project" data-title="tdmbot">
        <div class="project-shot">
          <img src="/images/discordbot.webp" alt="" loading="lazy" />
        </div>
        <div class="project-body">
          <h3>TDMBOT💠</h3>
          <p
            data-es="Un bot de Discord multifuncional con comandos de moderación, música y entretenimiento."
            data-en="A multifunctional Discord bot with moderation, music, and entertainment commands."
          >
            Un bot de Discord multifuncional con comandos de moderación, música
            y entretenimiento.
          </p>
          <ul class="tags">
            <li>python</li>
            <li>discord</li>
          </ul>
          <a
            href="https://discord.com/oauth2/authorize?client_id=1367861699683549276"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-term"
          >
            <span data-es="Ver proyecto" data-en="View project"
              >Ver proyecto</span
            > →
          </a>
        </div>
      </article>

      <article class="panel project" data-title="advad">
        <div class="project-shot">
          <img src="/images/advad.webp" alt="ADVAD Game" loading="lazy" />
        </div>
        <div class="project-body">
          <h3>ADVAD</h3>
          <p
            data-es="Juego de naves espaciales estilo 'shoot 'em up'. ¡Esquiva y dispara para sobrevivir!"
            data-en="A 'shoot 'em up' style spaceship game. Dodge and shoot to survive!"
          >
            Juego de naves espaciales estilo 'shoot 'em up'. ¡Esquiva y dispara
            para sobrevivir!
          </p>
          <ul class="tags">
            <li>godot</li>
          </ul>
          <a href="/advad" class="btn-term">
            <span data-es="Jugar ahora" data-en="Play now">Jugar ahora</span> →
          </a>
        </div>
      </article>

      <article class="panel project is-violet" data-title="tutorgebra">
        <div class="project-shot">
          <img src="/images/tutorgebra.webp" alt="Tutorgebra" loading="lazy" />
        </div>
        <div class="project-body">
          <h3>Tutorgebra</h3>
          <p
            data-es="Tutor de geometría interactivo automatizado."
            data-en="Your automated interactive geometry tutor."
          >
            Tutor de geometría interactivo automatizado.
          </p>
          <ul class="tags">
            <li>python</li>
            <li>vue</li>
            <li>fastapi</li>
          </ul>
          <a
            href="https://tutorgebra-production.up.railway.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-term"
          >
            <span data-es="Ver proyecto" data-en="View project"
              >Ver proyecto</span
            > →
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- Skills -->
  <section class="block" id="skills">
    <Prompt cmd="systemctl list-units --type=skill" />
    <div class="out">
      <ul class="units">
        {
          skills.map((s) => (
            <li>
              Loaded <b>{s}.skill</b>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Media -->
  <section class="block" id="media">
    <Prompt cmd="mpv --playlist=latest.m3u" />
    <div class="out media">
      <div class="panel" data-title="youtube">
        <h2 class="sr-only" data-es="Último Video" data-en="Latest Video">
          Último Video
        </h2>
        <div class="ratio">
          <iframe
            src="https://www.youtube.com/embed/fvGxdAOImEM?si=A5skYuDu_jpQ5wN4"
            title="YouTube video"
            loading="lazy"
            allowfullscreen></iframe>
        </div>
      </div>
      <div class="panel" data-title="soundcloud">
        <iframe
          height="120"
          title="SoundCloud player"
          loading="lazy"
          allow="autoplay; encrypted-media"
          src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2237961536&color=%233fe0ff&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Interactive shell -->
  <section class="block" id="shell">
    <p
      class="dim"
      data-es="# esta terminal es real: escribe `help` y pulsa Enter"
      data-en="# this terminal is real: type `help` and press Enter"
    >
