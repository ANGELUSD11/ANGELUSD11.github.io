---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="ADVAD - ANGELUS11">
    <div class="container-fluid p-0 position-relative" style="z-index: 10;">
        <section class="py-5 px-4">
            <div class="container">
                <div
                    class="d-flex justify-content-center align-items-center gap-3 mb-3"
                >
                    <img
                        src="/images/ADVADLOGODEF.png"
                        alt="ADVAD Logo"
                        class="game-logo img-fluid"
                    />
                    <div class="d-flex flex-column gap-2">
                        <a
                            href="https://advad1d.github.io/advad-leaderboard-front/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-outline-primary rounded-circle"
                            style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;"
                            title="Leaderboards"
                        >
                            <i class="fas fa-trophy"></i>
                        </a>
                        <a
                            href="https://angelus11.itch.io/advad-demo"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-outline-primary rounded-circle"
                            style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;"
                            title="Ver en itch.io"
                        >
                            <i class="fab fa-itch-io"></i>
                        </a>
                    </div>
                </div>
                <div class="game-stage mx-auto">
                    <iframe
                        id="advadFrame"
                        class="game-frame"
                        frameborder="0"
                        title="ADVAD demo"
                        src="/advad-game/"
                        allow="autoplay; fullscreen; gamepad; clipboard-write"
                        allowfullscreen></iframe>
                </div>

                <div class="card bg-dark-subtle border-primary mt-4">
                    <div class="card-body">
                        <h2 class="card-title text-primary mb-4">
                            <i class="fas fa-gamepad me-2"></i>
                            <span
                                data-es="Sobre el juego"
                                data-en="About the game"
                                >Sobre el juego
                            </span>
                        </h2>
                        <p
                            class="card-text text-white"
                            data-es="ADVAD es un 'shoot 'em up' espacial de ritmo rápido. Pilota tu nave, esquiva oleadas de enemigos y asteroides, y destruye todo a tu paso para conseguir la puntuación más alta. ¿Cuánto tiempo podrás sobrevivir?"
                            data-en="ADVAD is a fast-paced space shoot 'em up. Pilot your ship, dodge waves of enemies and asteroids, and destroy everything in your path to get the highest score. How long can you survive?"
                        >
                            ADVAD es un 'shoot 'em up' espacial de ritmo rápido.
                            Pilota tu nave, esquiva oleadas de enemigos y
                            asteroides, y destruye todo a tu paso para conseguir
                            la puntuación más alta. ¿Cuánto tiempo podrás
                            sobrevivir?
                        </p>

                        <div
                            class="alert alert-info mt-4 mb-0 py-2"
                            role="alert"
                            style="font-size: 0.9rem;"
                        >
                            <i class="fas fa-info-circle me-2"></i>
                            <span
                                data-es="Nota de privacidad: El juego genera y recopila un identificador único de tu navegador de forma local para guardar de manera anónima tu puntuación en la tabla de clasificación de nuestro servidor (alojado en Render)."
                                data-en="Privacy note: The game generates and collects a unique identifier from your browser locally to anonymously save your score on our leaderboard server (hosted on Render)."
                            >
                                Nota de privacidad: El juego genera y recopila
                                un identificador único de tu navegador de forma
                                local para guardar de manera anónima tu
                                puntuación en la tabla de clasificación de
                                nuestro servidor (alojado en Render).
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Giscus Comments -->
                <div
                    class="mt-4"
                    style="border-radius: 12px; padding: 1.5rem; background: #01060D; box-shadow: 0 4px 6px rgba(0,0,0,0.3);"
                >
                    <div class="giscus"></div>
                </div>
            </div>
        </section>
    </div>

    <script
        src="https://giscus.app/client.js"
        data-repo="ADVAD1D/ADVAD1D"
        data-repo-id="R_kgDOPjEwwA"
        data-category="General"
        data-category-id="DIC_kwDOPjEwwM4C3oXc"
        data-mapping="number"
        data-term="5"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="dark_dimmed"
        data-lang="es"
        crossorigin="anonymous"
        async
        is:inline></script>

    <!-- Back Button (floating in advad) -->
    <div class="back-button">
        <a href="/" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i>
        </a>
    </div>

    <!-- Language Switcher Button (floating in advad) -->
    <div class="language-switcher">
        <button id="langBtn" class="btn btn-outline-primary">
            <i class="fas fa-globe"></i>
            <span id="langText">EN</span>
        </button>
    </div>

    <style>
        /* "Escenario" del juego: reserva el espacio visual y recorta el iframe escalado.
           Misma proporción que la resolución nativa del juego (520x300). */
        .game-stage {
            position: relative;
            width: 100%;
            max-width: 1040px; /* ancho visual maximo (el render es 780, se escala ~1.33x) */
            aspect-ratio: 520 / 300;
            margin-inline: auto;
            overflow: hidden;
            background: #000;
            border-radius: 8px;
        }

        /* El iframe renderiza 780x450 px reales (1.5x el nativo 520x300, misma
           proporcion): el shader CRT procesa ~351k px en vez de ~2M, sigue barato
           y los textos del juego se leen mejor. El tamano visual grande lo da el
           transform: scale() de fitAdvad(). */
        .game-frame {
            position: absolute;
            top: 0;
            left: 0;
            width: 780px;
            height: 450px;
            border: 0;
            transform-origin: top left;
            image-rendering: pixelated; /* upscale nitido para el pixel-art */
        }
    </style>

    <script is:inline>
        // Renderiza a 780x450 (barato para el shader) y escala por CSS hasta
        // llenar el ancho real del "escenario". El divisor DEBE ser el mismo
        // numero que el width del .game-frame, o el iframe se desborda.
        function fitAdvad() {
            const stage = document.querySelector(".game-stage");
            const frame = document.getElementById("advadFrame");
            if (!stage || !frame) return;
            const scale = stage.clientWidth / 780;
            frame.style.transform = "scale(" + scale + ")";
        }
        window.addEventListener("resize", fitAdvad);
        window.addEventListener("load", fitAdvad);
        fitAdvad();
    </script>
</Layout>
