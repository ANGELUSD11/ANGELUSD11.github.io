---
import Layout from "../../layouts/Layout.astro";
import Prompt from "../../components/Prompt.astro";
---

<Layout title="ADVAD - ANGELUS11" path="~/advad" active="advad">
    <section class="block">
        <Prompt cmd="./advad --demo" path="~/advad" />
        <div class="out">
            <div class="advad-head">
                <h1 class="sr-only">ADVAD</h1>
                <img
                    src="/images/ADVADLOGODEF.png"
                    alt="ADVAD Logo"
                    class="game-logo"
                />
                <div class="advad-links">
                    <a
                        href="https://advad1d.github.io/advad-leaderboard-front/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-term"
                    >
                        leaderboards →
                    </a>
                    <a
                        href="https://angelus11.itch.io/advad-demo"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-term"
                    >
                        itch.io →
                    </a>
                </div>
            </div>

            <div class="crt">
                <div class="game-stage">
                    <iframe
                        id="advadFrame"
                        class="game-frame"
                        frameborder="0"
                        title="ADVAD demo"
                        src="/advad-game/"
                        allow="autoplay; fullscreen; gamepad; clipboard-write"
                        allowfullscreen></iframe>
                </div>
            </div>

            <div class="source-switch">
                <span class="dim">--source=</span>
                <button
                    class="btn-term active"
                    type="button"
                    data-source="repo"
                    onclick="setGameSource('repo')"
                    title="Local Server"
                >
                    local
                </button>
                <button
                    class="btn-term"
                    type="button"
                    data-source="itch"
                    onclick="setGameSource('itch')"
                    title="itch.io Version"
                >
                    itch.io
                </button>
            </div>
        </div>
    </section>

    <section class="block">
        <Prompt cmd="cat README.md" path="~/advad" />
        <div class="out">
            <h2 data-es="Sobre el juego" data-en="About the game">
                Sobre el juego
            </h2>
            <p
                class="prose"
                data-es="ADVAD es un 'shoot 'em up' espacial de ritmo rápido. Pilota tu nave, esquiva oleadas de enemigos y asteroides, y destruye todo a tu paso para conseguir la puntuación más alta. ¿Cuánto tiempo podrás sobrevivir?"
                data-en="ADVAD is a fast-paced space shoot 'em up. Pilot your ship, dodge waves of enemies and asteroids, and destroy everything in your path to get the highest score. How long can you survive?"
            >
                ADVAD es un 'shoot 'em up' espacial de ritmo rápido. Pilota tu
                nave, esquiva oleadas de enemigos y asteroides, y destruye todo
                a tu paso para conseguir la puntuación más alta. ¿Cuánto tiempo
                podrás sobrevivir?
            </p>

            <p class="log-warn prose" role="note">
                <span
                    data-es="Nota de privacidad: El juego genera y recopila un identificador único de tu navegador de forma local para guardar de manera anónima tu puntuación en la tabla de clasificación de nuestro servidor (alojado en Render)."
                    data-en="Privacy note: The game generates and collects a unique identifier from your browser locally to anonymously save your score on our leaderboard server (hosted on Render)."
                >
                    Nota de privacidad: El juego genera y recopila un
                    identificador único de tu navegador de forma local para
                    guardar de manera anónima tu puntuación en la tabla de
                    clasificación de nuestro servidor (alojado en Render).
                </span>
            </p>
        </div>
    </section>

    <!-- Giscus Comments -->
    <section class="block">
        <Prompt cmd="tail -f comments.log" path="~/advad" />
        <div class="out panel" data-title="giscus">
            <div class="giscus"></div>
        </div>
    </section>

    <script
        src="https://giscus.app/client.js"
        data-repo="ADVAD1D/ADVAD1D"
        data-repo-id="R_kgDOPjEwwA"
        data-category="General"
        data-category-id="DIC_kwDOPjEwwM4C3oXc"
        data-mapping="number"
        data-term="5"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="transparent_dark"
        data-lang="es"
        crossorigin="anonymous"
        async
        is:inline></script>

    <style>
        /* Game "Stage": reserves visual space and clips the scaled iframe.
           Same proportion as the game's native resolution (520x300). */
        .game-stage {
            position: relative;
            width: 100%;
            aspect-ratio: 520 / 300;
            overflow: hidden;
            background: #000;
        }

        /* The iframe renders at an actual 780x450 px (1.5x the native 520x300, same
           proportion): the CRT shader processes ~351k px instead of ~2M, keeping it cheap
           and making in-game text more readable. The large visual size is provided by the
           transform: scale() in fitAdvad(). */
        .game-frame {
            position: absolute;
            top: 0;
            left: 0;
            width: 780px;
            height: 450px;
            border: 0;
            transform-origin: top left;
            image-rendering: pixelated; /* crisp upscale for pixel-art */
        }
    </style>

    <script is:inline>
        function setGameSource(source) {
            const frame = document.getElementById("advadFrame");
            if (!frame) return;

            if (source === 'itch') {
                frame.src = "https://itch.io/embed-upload/16830827?color=00477e";
            } else {
                frame.src = "/advad-game/";
            }

            document.querySelectorAll("[data-source]").forEach((btn) => {
                btn.classList.toggle("active", btn.dataset.source === source);
            });

            // Re-focus the frame so the user can play immediately without clicking inside first
            frame.focus();
        }

        // Renders at 780x450 (cheap for the shader) and scales via CSS until
        // it fills the actual width of the "stage". The divisor MUST be the same
        // number as the width of the .game-frame, or the iframe will overflow.
        function fitAdvad() {
            const stage = document.querySelector(".game-stage");
            const frame = document.getElementById("advadFrame");
            if (!stage || !frame) return;
            const scale = stage.clientWidth / 780;
            frame.style.transform = "scale(" + scale + ")";
        }
        window.addEventListener("resize", fitAdvad);
        window.addEventListener("load", fitAdvad);
        fitAdvad();
    </script>
</Layout>
