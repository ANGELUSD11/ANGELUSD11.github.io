---
import Layout from "../../layouts/Layout.astro";
import Prompt from "../../components/Prompt.astro";
import Post1 from "../../components/blog/Post1.astro";
import Post2 from "../../components/blog/Post2.astro";
import Post3 from "../../components/blog/Post3.astro";
import Post4 from "../../components/blog/Post4.astro";
import Post5 from "../../components/blog/Post5.astro";

const banner = String.raw`
██████╗ ███████╗██╗   ██╗██╗      ██████╗  ██████╗
██╔══██╗██╔════╝██║   ██║██║     ██╔═══██╗██╔════╝
██║  ██║█████╗  ██║   ██║██║     ██║   ██║██║  ███╗
██║  ██║██╔══╝  ╚██╗ ██╔╝██║     ██║   ██║██║   ██║
██████╔╝███████╗ ╚████╔╝ ███████╗╚██████╔╝╚██████╔╝
╚═════╝ ╚══════╝  ╚═══╝  ╚══════╝ ╚═════╝  ╚═════╝`.slice(1);
---

<Layout title="Blog - ANGELUS11" path="~/devlog" active="devlog">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css"
    />
  </Fragment>

  <section class="block">
    <Prompt cmd="cd ~/devlog && cat README" path="~" />
    <div class="out">
      <h1 class="sr-only">DEVLOG</h1>
      <pre class="ascii banner banner-sm" aria-hidden="true">{banner}</pre>
      <p
        class="tagline"
        data-es="Notas de desarrollo, machine learning y gamedev"
        data-en="Notes on development, machine learning and gamedev"
      >
        Notas de desarrollo, machine learning y gamedev
      </p>
    </div>
  </section>

  <section class="block">
    <Prompt cmd="ls -t | xargs cat" path="~/devlog" />
    <div class="out posts">
      <Post5 />
      <Post1 />
      <Post2 />
      <Post3 />
      <Post4 />
    </div>
  </section>

  <!-- Prism JS for syntax highlighting -->
  <Fragment slot="scripts">
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/normalize-whitespace/prism-normalize-whitespace.min.js"
    ></script>
    <script is:inline>
      // Configuración de Prism Normalize Whitespace
      // Wait for DOM to finish loading just in case
      window.addEventListener("DOMContentLoaded", () => {
        if (
          typeof Prism !== "undefined" &&
          Prism.plugins &&
          Prism.plugins.NormalizeWhitespace
        ) {
          Prism.plugins.NormalizeWhitespace.setDefaults({
            "remove-trailing": true,
            "remove-indent": true,
            "left-trim": true,
            "right-trim": true,
          });
          Prism.highlightAll();
        }
      });
    </script>
  </Fragment>
</Layout>
